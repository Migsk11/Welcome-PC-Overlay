<Window
    x:Class="front_wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:front_wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="mainWindow"
    Title="MainWindow"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>

        <Storyboard x:Key="BoasVindas-FadeInFadeOut">
            <DoubleAnimation
                Storyboard.TargetName="BoasVindas"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:3" />
            <DoubleAnimation
                BeginTime="0:0:3"
                Storyboard.TargetName="BoasVindas"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:5" />
            <DoubleAnimation
                Storyboard.TargetName="TimeAndDate"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:3" />
            <DoubleAnimation
                BeginTime="0:0:3"
                Storyboard.TargetName="TimeAndDate"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:5" />
        </Storyboard>

    </Window.Resources>




    <Grid HorizontalAlignment="center" VerticalAlignment="center">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources> 
            <Style TargetType="Label"> 
                <Setter Property="Foreground" Value="#3B82F6"/>
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="center"/>
            </Style>
        </Grid.Resources>


        <Label
            x:Name="TimeAndDate"
            Grid.Row="0"
            Content=""
            FontSize="50"
            FontStyle="Italic"
        />

        <!-- Margin="Esquerda, Cima, Direita, Baixo" -->
        <Label
            x:Name="BoasVindas"
            Grid.Row="1"
            Margin="0,-50,0,0"
            Content="Bem vindo ao seu PC!"
            FontSize="125"
            FontWeight="Light"
            FontStyle="Normal"
        />

    </Grid>




</Window>
